  "author": "Project OSRM",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Project-OSRM/gauche-rs.git"
  },
  "homepage": "https://github.com/Project-OSRM/gauche-rs#readme",
  "bugs": {
    "url": "https://github.com/Project-OSRM/gauche-rs/issues"
  },
  "keywords": [
    "osrm",
    "routing",
    "traffic",
    "left-hand-traffic",
